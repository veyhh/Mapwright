; Minimal Godot project used by Mapwright capture examples.
config_version=5

[application]

config/name="Mapwright Capture Examples"

[display]

window/size/viewport_width=1
window/size/viewport_height=1
window/size/window_width_override=1
window/size/window_height_override=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.18, 1)
